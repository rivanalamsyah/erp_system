@page "/"
@inject IApplicationDbContext DbContext
@inject ICurrentUserService CurrentUserService
@using Microsoft.EntityFrameworkCore

<PageTitle>Dashboard Eksekutif — Enterprise ERP</PageTitle>

<div class="mb-6">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 700; color: #0F172A;">
                Dashboard Eksekutif & Ringkasan Bisnis
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #64748B;">
                Pantauan KPI operasional, persediaan gudang, dan integritas multi-cabang secara terintegrasi.
            </MudText>
        </div>
        <div class="mt-3 mt-sm-0 d-flex align-center">
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                Sistem Online &bull; DB Connected
            </MudChip>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg border border-slate-200">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; text-transform: uppercase;">
                    Total Entitas Usaha
                </MudText>
                <div class="pa-2 rounded-circle" style="background-color: #EFF6FF;">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Size="Size.Small" />
                </div>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #0F172A;">
                @_totalCompanies
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #16A34A; font-weight: 500;">
                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Style="font-size: 0.8rem;" />
                Holding & Multi-Company Aktif
            </MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg border border-slate-200">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; text-transform: uppercase;">
                    Kantor Cabang
                </MudText>
                <div class="pa-2 rounded-circle" style="background-color: #F0FDF4;">
                    <MudIcon Icon="@Icons.Material.Filled.Store" Color="Color.Success" Size="Size.Small" />
                </div>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #0F172A;">
                @_totalBranches
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #64748B;">
                Cabang Operasional Terdaftar
            </MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg border border-slate-200">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; text-transform: uppercase;">
                    Katalog Produk Aktif
                </MudText>
                <div class="pa-2 rounded-circle" style="background-color: #FDF4FF;">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Secondary" Size="Size.Small" />
                </div>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #0F172A;">
                @_totalProducts
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #64748B;">
                SKU Barang & Layanan
            </MudText>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg border border-slate-200">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; text-transform: uppercase;">
                    Jejak Audit Tersimpan
                </MudText>
                <div class="pa-2 rounded-circle" style="background-color: #FFFBEB;">
                    <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Warning" Size="Size.Small" />
                </div>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #0F172A;">
                @_totalAuditLogs
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #64748B;">
                Catatan Transaksi Aman
            </MudText>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Quick Action Modules & Status -->
<MudGrid>
    <MudItem xs="12" md="8">
        <MudCard Elevation="1" Class="pa-5 rounded-lg border border-slate-200">
            <MudText Typo="Typo.h6" Style="font-weight: 600; color: #0F172A;" Class="mb-1">
                Pusat Navigasi & Manajemen Modul ERP
            </MudText>
            <MudText Typo="Typo.body2" Style="color: #64748B;" Class="mb-4">
                Pilih modul bisnis di bawah ini untuk memulai input transaksi atau mengelola data master:
            </MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200 cursor-pointer hover:shadow-md transition-all"
                              @onclick="@(() => Navigation.NavigateTo("/master/companies"))"
                              Style="border-left: 4px solid #1E3A8A !important;">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                Master Perusahaan & Cabang
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #64748B; display: block;">
                            Atur entitas legal PT/CV, kantor pusat, dan cabang operasional regional.
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200 cursor-pointer hover:shadow-md transition-all"
                              @onclick="@(() => Navigation.NavigateTo("/master/products"))"
                              Style="border-left: 4px solid #0F766E !important;">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Secondary" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                Master Katalog & Produk
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #64748B; display: block;">
                            Kelola SKU produk, satuan (UoM), kategori, dan penetapan harga jual-beli.
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200 cursor-pointer hover:shadow-md transition-all"
                              @onclick="@(() => Navigation.NavigateTo("/master/customers"))"
                              Style="border-left: 4px solid #2563EB !important;">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Info" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                Pelanggan & Mitra Usaha
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #64748B; display: block;">
                            Registrasi data pelanggan, limit pagu kredit, termin bayar, dan NPWP.
                        </MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Class="pa-4 rounded-lg border border-slate-200 cursor-pointer hover:shadow-md transition-all"
                              @onclick="@(() => Navigation.NavigateTo("/security/users"))"
                              Style="border-left: 4px solid #D97706 !important;">
                        <div class="d-flex align-center mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Warning" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                Tata Kelola & PBAC
                            </MudText>
                        </div>
                        <MudText Typo="Typo.caption" Style="color: #64748B; display: block;">
                            Manajemen pengguna, pemetaan hak akses PBAC, dan audit trail operasional.
                        </MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="1" Class="pa-5 rounded-lg border border-slate-200">
            <MudText Typo="Typo.h6" Style="font-weight: 600; color: #0F172A;" Class="mb-3">
                Informasi Lingkungan Sistem
            </MudText>

            <MudStack Spacing="2">
                <div class="d-flex justify-space-between py-1 border-b border-slate-100">
                    <MudText Typo="Typo.caption" Style="color: #64748B;">Arsitektur</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight: 600;">Modular Monolith Clean Arch</MudText>
                </div>
                <div class="d-flex justify-space-between py-1 border-b border-slate-100">
                    <MudText Typo="Typo.caption" Style="color: #64748B;">Runtime & Platform</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight: 600;">.NET 10 LTS &bull; C# 14</MudText>
                </div>
                <div class="d-flex justify-space-between py-1 border-b border-slate-100">
                    <MudText Typo="Typo.caption" Style="color: #64748B;">Database Server</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight: 600;">PostgreSQL 18 (Port 5433)</MudText>
                </div>
                <div class="d-flex justify-space-between py-1 border-b border-slate-100">
                    <MudText Typo="Typo.caption" Style="color: #64748B;">Otorisasi Keamanan</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight: 600; color: #16A34A;">PBAC & Data Scoping</MudText>
                </div>
                <div class="d-flex justify-space-between py-1 border-b border-slate-100">
                    <MudText Typo="Typo.caption" Style="color: #64748B;">UI Component Kit</MudText>
                    <MudText Typo="Typo.caption" Style="font-weight: 600;">MudBlazor v9 Enterprise</MudText>
                </div>
            </MudStack>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    [Inject] NavigationManager Navigation { get; set; } = default!;

    private int _totalCompanies;
    private int _totalBranches;
    private int _totalProducts;
    private int _totalAuditLogs;

    protected override async Task OnInitializedAsync()
    {
        _totalCompanies = await DbContext.Companies.IgnoreQueryFilters().CountAsync();
        _totalBranches = await DbContext.Branches.IgnoreQueryFilters().CountAsync();
        _totalProducts = await DbContext.Products.IgnoreQueryFilters().CountAsync();
        _totalAuditLogs = await DbContext.AuditLogs.CountAsync();
    }
}
