@page "/procurement/orders"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Purchase Orders - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Purchase Orders</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola surat pesanan pembelian barang ke vendor rekanan
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Buat PO Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor PO atau nama supplier..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_orders"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. PO</MudTh>
                    <MudTh>Supplier</MudTh>
                    <MudTh>Tgl Order</MudTh>
                    <MudTh>Est. Pengiriman</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Subtotal</MudTh>
                    <MudTh Style="text-align: right;">PPN (11%)</MudTh>
                    <MudTh Style="text-align: right;">Total Nilai PO</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. PO">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.PoNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
                    <MudTd DataLabel="Tgl Order">@context.OrderDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Est. Pengiriman">@(context.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Subtotal" Style="text-align: right;">Rp @context.SubtotalAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="PPN" Style="text-align: right;">Rp @context.TaxAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="Total Nilai PO" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            Rp @context.TotalAmount.ToString("N0")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       Title="Lihat Detail Item"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft" || context.Status == "PendingApproval")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           Title="Setujui PO"
                                           OnClick="@(() => ApprovePo(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data Purchase Order.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail PO: @_selectedPo?.PoNumber - @_selectedPo?.SupplierName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedPo != null)
        {
            <MudTable Items="@_selectedPo.Items" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Nama Produk</MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align: right;">Qty Dipesan</MudTh>
                    <MudTh Style="text-align: right;">Qty Diterima</MudTh>
                    <MudTh Style="text-align: right;">Harga Satuan</MudTh>
                    <MudTh Style="text-align: right;">Diskon %</MudTh>
                    <MudTh Style="text-align: right;">Total Baris</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductSku</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.UomCode</MudTd>
                    <MudTd Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd Style="@($"text-align: right; color: {(context.ReceivedQuantity >= context.Quantity ? "green" : "orange")};")">
                        @context.ReceivedQuantity.ToString("N2")
                    </MudTd>
                    <MudTd Style="text-align: right;">Rp @context.UnitPrice.ToString("N0")</MudTd>
                    <MudTd Style="text-align: right;">@context.DiscountRate.ToString("N1")%</MudTd>
                    <MudTd Style="text-align: right;" Class="fw-semibold">Rp @context.LineTotal.ToString("N0")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Buat Purchase Order Baru</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Supplier / Vendor" @bind-Value="_formSupplierId" Required="true">
                    @foreach (var s in _availableSuppliers)
                    {
                        <MudSelectItem Value="@s.Id">@s.Name (@s.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Tanggal Order" @bind-Date="_formOrderDate" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Est. Tanggal Pengiriman" @bind-Date="_formExpectedDeliveryDate" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Item Produk PO</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddFormLine">
                        Tambah Baris
                    </MudButton>
                </div>

                @foreach (var line in _formLines)
                {
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudSelect T="Guid" Label="Produk" Value="line.ProductId" ValueChanged="@((Guid id) => OnProductSelected(line, id))" Dense="true" Style="min-width: 220px;">
                            @foreach (var prod in _availableProducts)
                            {
                                <MudSelectItem Value="@prod.Id">@prod.Name (@prod.Sku)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" Label="Qty" @bind-Value="line.Quantity" Min="0.01m" Dense="true" Style="width: 80px;" />
                        <MudNumericField T="decimal" Label="Harga Beli" @bind-Value="line.UnitPrice" Min="0m" Dense="true" Style="width: 140px;" />
                        <MudNumericField T="decimal" Label="Disc %" @bind-Value="line.DiscountRate" Min="0m" Max="100m" Dense="true" Style="width: 80px;" />
                        <MudText Typo="Typo.body2" Class="fw-semibold px-2" Style="min-width: 120px; text-align: right;">
                            Rp @((line.Quantity * line.UnitPrice * (1 - (line.DiscountRate / 100m))).ToString("N0"))
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _formLines.Remove(line))" Disabled="@(_formLines.Count <= 1)" />
                    </div>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan PO</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PurchaseOrderDto> _orders = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private PurchaseOrderDto? _selectedPo;

    private bool _createOpen = false;
    private Guid _formSupplierId;
    private DateTime? _formOrderDate = DateTime.Today;
    private DateTime? _formExpectedDeliveryDate = DateTime.Today.AddDays(7);
    private List<CreatePoLineModel> _formLines = [];

    private List<SupplierSummary> _availableSuppliers = [];
    private List<ProductSummary> _availableProducts = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreatePoLineModel
    {
        public Guid ProductId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountRate { get; set; }
    }

    public record SupplierSummary(Guid Id, string Code, string Name);
    public record ProductSummary(Guid Id, string Sku, string Name, decimal BaseCost);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        _availableSuppliers = await DbContext.Suppliers
            .AsNoTracking()
            .Where(s => s.IsActive)
            .OrderBy(s => s.Name)
            .Select(s => new SupplierSummary(s.Id, s.Code, s.Name))
            .ToListAsync();

        _availableProducts = await DbContext.Products
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.Name)
            .Select(p => new ProductSummary(p.Id, p.Sku, p.Name, p.PurchasePrice))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetPurchaseOrdersQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _orders = result.Value.Items.ToList();
                _totalPages = (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize);
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat PO: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(PurchaseOrderDto po)
    {
        _selectedPo = po;
        _detailsOpen = true;
    }

    private void OpenCreateDialog()
    {
        _formSupplierId = _availableSuppliers.FirstOrDefault()?.Id ?? Guid.Empty;
        _formOrderDate = DateTime.Today;
        _formExpectedDeliveryDate = DateTime.Today.AddDays(7);

        var firstProd = _availableProducts.FirstOrDefault();
        _formLines =
        [
            new CreatePoLineModel
            {
                ProductId = firstProd?.Id ?? Guid.Empty,
                Quantity = 1,
                UnitPrice = firstProd?.BaseCost ?? 0,
                DiscountRate = 0
            }
        ];
        _createOpen = true;
    }

    private void OnProductSelected(CreatePoLineModel line, Guid productId)
    {
        line.ProductId = productId;
        var p = _availableProducts.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.UnitPrice = p.BaseCost;
        }
    }

    private void AddFormLine()
    {
        var firstProd = _availableProducts.FirstOrDefault();
        _formLines.Add(new CreatePoLineModel
        {
            ProductId = firstProd?.Id ?? Guid.Empty,
            Quantity = 1,
            UnitPrice = firstProd?.BaseCost ?? 0,
            DiscountRate = 0
        });
    }

    private async Task SaveCreate()
    {
        if (_formSupplierId == Guid.Empty)
        {
            Snackbar.Add("Silakan pilih vendor/supplier.", Severity.Warning);
            return;
        }

        if (_formLines.Count == 0 || _formLines.Any(l => l.ProductId == Guid.Empty || l.Quantity <= 0))
        {
            Snackbar.Add("Mohon lengkapi baris item produk PO dengan kuantitas valid.", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreatePurchaseOrderCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            SupplierId: _formSupplierId,
            OrderDate: DateOnly.FromDateTime(_formOrderDate ?? DateTime.Today),
            ExpectedDeliveryDate: _formExpectedDeliveryDate.HasValue ? DateOnly.FromDateTime(_formExpectedDeliveryDate.Value) : null,
            Items: _formLines.Select(l => new PoItemInput(l.ProductId, l.Quantity, l.UnitPrice, l.DiscountRate)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Purchase Order berhasil diterbitkan.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task ApprovePo(PurchaseOrderDto po)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Persetujuan PO",
            $"Apakah Anda yakin ingin menyetujui Purchase Order {po.PoNumber} senilai Rp {po.TotalAmount:N0}?",
            yesText: "Setujui PO",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new ApprovePurchaseOrderCommand(po.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"PO {po.PoNumber} telah berhasil disetujui.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "PendingApproval" => Color.Warning,
        "Approved" => Color.Info,
        "PartiallyReceived" => Color.Secondary,
        "FullyReceived" => Color.Success,
        "Billed" => Color.Primary,
        "Closed" => Color.Dark,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}
