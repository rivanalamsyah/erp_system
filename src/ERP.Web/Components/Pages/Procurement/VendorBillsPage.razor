@page "/procurement/bills"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Vendor Bills - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Vendor Bills (Faktur Hutang Usaha)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola faktur tagihan dari vendor dan pencatatan hutang dagang (Accounts Payable)
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Catat Tagihan Vendor
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor tagihan, faktur vendor, atau PO..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_bills"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. Tagihan</MudTh>
                    <MudTh>Faktur Vendor</MudTh>
                    <MudTh>Supplier</MudTh>
                    <MudTh>Ref. PO</MudTh>
                    <MudTh>Tgl Tagihan</MudTh>
                    <MudTh>Jatuh Tempo</MudTh>
                    <MudTh Style="text-align: right;">Total Tagihan</MudTh>
                    <MudTh Style="text-align: right;">Sisa Hutang</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. Tagihan">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.BillNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Faktur Vendor">@context.VendorInvoiceNumber</MudTd>
                    <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
                    <MudTd DataLabel="Ref. PO">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.PoNumber</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Tgl Tagihan">@context.BillDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Jatuh Tempo">@context.DueDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Total Tagihan" Style="text-align: right;">
                        Rp @context.TotalAmount.ToString("N0")
                    </MudTd>
                    <MudTd DataLabel="Sisa Hutang" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Class="fw-bold" Color="@(context.RemainingAmount > 0 ? Color.Error : Color.Success)">
                            Rp @context.RemainingAmount.ToString("N0")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        @if (context.Status == "Draft")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => PostBill(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data tagihan vendor.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Pencatatan Tagihan Vendor Baru</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudSelect T="Guid" Label="Pilih Purchase Order" Value="_formPoId" ValueChanged="OnPoSelected" Required="true">
                    @foreach (var po in _availablePos)
                    {
                        <MudSelectItem Value="@po.Id">@po.PoNumber - @po.SupplierName (Rp @po.TotalAmount.ToString("N0"))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_formVendorInvoiceNumber" Label="Nomor Faktur dari Vendor / Kwitansi" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Tagihan" @bind-Date="_formBillDate" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Jatuh Tempo" @bind-Date="_formDueDate" />
            </MudItem>
            @if (_selectedPoSummary != null)
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Normal" Dense="true">
                        Total Tagihan: <strong>Rp @_selectedPoSummary.TotalAmount.ToString("N0")</strong> (Vendor: @_selectedPoSummary.SupplierName)
                    </MudAlert>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan Tagihan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<VendorBillDto> _bills = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _createOpen = false;
    private Guid _formPoId;
    private string _formVendorInvoiceNumber = string.Empty;
    private DateTime? _formBillDate = DateTime.Today;
    private DateTime? _formDueDate = DateTime.Today.AddDays(30);

    private List<PoBillingSummary> _availablePos = [];
    private PoBillingSummary? _selectedPoSummary;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    public record PoBillingSummary(Guid Id, string PoNumber, string SupplierName, decimal TotalAmount);

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailablePos();
        await LoadData();
    }

    private async Task LoadAvailablePos()
    {
        _availablePos = await DbContext.PurchaseOrders
            .AsNoTracking()
            .Where(p => (p.Status == PurchaseOrderStatus.Approved || p.Status == PurchaseOrderStatus.FullyReceived || p.Status == PurchaseOrderStatus.PartiallyReceived))
            .OrderByDescending(p => p.OrderDate)
            .Select(p => new PoBillingSummary(p.Id, p.PoNumber, p.Supplier.Name, p.TotalAmount))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetVendorBillsQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            _bills = result.Items.ToList();
            _totalPages = (int)Math.Ceiling((double)result.TotalCount / _pageSize);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat Vendor Bills: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private async Task OpenCreateDialog()
    {
        await LoadAvailablePos();
        _formPoId = _availablePos.FirstOrDefault()?.Id ?? Guid.Empty;
        _formVendorInvoiceNumber = string.Empty;
        _formBillDate = DateTime.Today;
        _formDueDate = DateTime.Today.AddDays(30);
        _selectedPoSummary = _availablePos.FirstOrDefault();
        _createOpen = true;
    }

    private void OnPoSelected(Guid poId)
    {
        _formPoId = poId;
        _selectedPoSummary = _availablePos.FirstOrDefault(p => p.Id == poId);
    }

    private async Task SaveCreate()
    {
        if (_formPoId == Guid.Empty || string.IsNullOrWhiteSpace(_formVendorInvoiceNumber))
        {
            Snackbar.Add("Mohon pilih PO dan isi nomor faktur dari vendor.", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreateVendorBillCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            PurchaseOrderId: _formPoId,
            VendorInvoiceNumber: _formVendorInvoiceNumber,
            BillDate: DateOnly.FromDateTime(_formBillDate ?? DateTime.Today),
            DueDate: DateOnly.FromDateTime(_formDueDate ?? DateTime.Today.AddDays(30))
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Tagihan Vendor berhasil dibuat.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task PostBill(VendorBillDto bill)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Posting Tagihan",
            $"Posting tagihan {bill.BillNumber} senilai Rp {bill.TotalAmount:N0} ke buku besar Hutang Usaha (AP)?",
            yesText: "Posting Tagihan",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new PostVendorBillCommand(bill.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"Tagihan {bill.BillNumber} berhasil diposting.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Posted" => Color.Warning,
        "PartiallyPaid" => Color.Info,
        "Paid" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}

