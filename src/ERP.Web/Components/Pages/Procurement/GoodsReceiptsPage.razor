@page "/procurement/receipts"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Goods Receipts - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Goods Receipts (GRN)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola pencatatan dan penerimaan fisik barang dari vendor ke gudang penyimpanan
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Penerimaan Barang Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor GRN, surat jalan, PO..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_receipts"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. GRN</MudTh>
                    <MudTh>Surat Jalan Vendor</MudTh>
                    <MudTh>Gudang Masuk</MudTh>
                    <MudTh>Ref. PO</MudTh>
                    <MudTh>Supplier</MudTh>
                    <MudTh>Tgl Terima</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. GRN">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.ReceiptNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Surat Jalan">@context.DeliveryNoteNumber</MudTd>
                    <MudTd DataLabel="Gudang">@context.WarehouseName</MudTd>
                    <MudTd DataLabel="Ref. PO">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.PoNumber</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Supplier">@context.SupplierName</MudTd>
                    <MudTd DataLabel="Tgl Terima">@context.ReceiptDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Status == "Received" ? Color.Success : Color.Warning)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => ReceiveGrn(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data Goods Receipt.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail GRN: @_selectedGrn?.ReceiptNumber (PO: @_selectedGrn?.PoNumber)</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedGrn != null)
        {
            <MudTable Items="@_selectedGrn.Items" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Nama Produk</MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align: right;">Kuantitas Diterima</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductSku</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.UomCode</MudTd>
                    <MudTd Style="text-align: right;" Class="fw-bold">@context.QuantityReceived.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Penerimaan Barang Gudang (GRN)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Gudang Tujuan Masuk" @bind-Value="_formWarehouseId" Required="true">
                    @foreach (var wh in _availableWarehouses)
                    {
                        <MudSelectItem Value="@wh.Id">@wh.Name (@wh.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Pilih Purchase Order (Approved)" Value="_formPoId" ValueChanged="OnPoChanged" Required="true">
                    @foreach (var po in _openPurchaseOrders)
                    {
                        <MudSelectItem Value="@po.Id">@po.PoNumber - @po.SupplierName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_formDeliveryNoteNumber" Label="Nomor Surat Jalan Vendor" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Penerimaan" @bind-Date="_formReceiptDate" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Item Barang yang Diterima</MudText>

                @if (_formLines.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Pilih Purchase Order di atas untuk memuat daftar produk yang dipesan.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_formLines" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Produk</MudTh>
                            <MudTh Style="text-align: right;">Sisa Belum Diterima</MudTh>
                            <MudTh Style="text-align: right;">Qty Diterima Saat Ini</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName (@context.ProductSku)</MudTd>
                            <MudTd Style="text-align: right;">@context.RemainingQuantity.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right; width: 150px;">
                                <MudNumericField T="decimal" @bind-Value="context.QuantityReceived" Min="0" Max="@context.RemainingQuantity" Margin="Margin.Dense" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan GRN</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<GoodsReceiptDto> _receipts = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private GoodsReceiptDto? _selectedGrn;

    private bool _createOpen = false;
    private Guid _formWarehouseId;
    private Guid _formPoId;
    private string _formDeliveryNoteNumber = string.Empty;
    private DateTime? _formReceiptDate = DateTime.Today;
    private List<CreateGrnLineModel> _formLines = [];

    private List<WarehouseSummary> _availableWarehouses = [];
    private List<OpenPoSummary> _openPurchaseOrders = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreateGrnLineModel
    {
        public Guid PoItemId { get; set; }
        public Guid ProductId { get; set; }
        public string ProductSku { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public decimal RemainingQuantity { get; set; }
        public decimal QuantityReceived { get; set; }
    }

    public record WarehouseSummary(Guid Id, string Code, string Name);
    public record OpenPoSummary(Guid Id, string PoNumber, string SupplierName);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        _availableWarehouses = await DbContext.Warehouses
            .AsNoTracking()
            .Where(w => w.IsActive)
            .OrderBy(w => w.Name)
            .Select(w => new WarehouseSummary(w.Id, w.Code, w.Name))
            .ToListAsync();

        _openPurchaseOrders = await DbContext.PurchaseOrders
            .AsNoTracking()
            .Where(p => p.Status == PurchaseOrderStatus.Approved || p.Status == PurchaseOrderStatus.PartiallyReceived)
            .OrderByDescending(p => p.OrderDate)
            .Select(p => new OpenPoSummary(p.Id, p.PoNumber, p.Supplier.Name))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetGoodsReceiptsQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess && result.Value != null)
            {
                _receipts = result.Value.Items.ToList();
                _totalPages = Math.Max(1, (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize));
            }
            else if (result.IsFailure)
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat Goods Receipts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(GoodsReceiptDto grn)
    {
        _selectedGrn = grn;
        _detailsOpen = true;
    }

    private async Task OpenCreateDialog()
    {
        await LoadLookups();
        _formWarehouseId = _availableWarehouses.FirstOrDefault()?.Id ?? Guid.Empty;
        _formPoId = _openPurchaseOrders.FirstOrDefault()?.Id ?? Guid.Empty;
        _formDeliveryNoteNumber = string.Empty;
        _formReceiptDate = DateTime.Today;
        _formLines.Clear();

        if (_formPoId != Guid.Empty)
        {
            await OnPoChanged(_formPoId);
        }

        _createOpen = true;
    }

    private async Task OnPoChanged(Guid poId)
    {
        _formPoId = poId;
        _formLines.Clear();

        if (poId == Guid.Empty) return;

        var po = await DbContext.PurchaseOrders
            .Include(p => p.Items)
                .ThenInclude(i => i.Product)
            .AsNoTracking()
            .FirstOrDefaultAsync(p => p.Id == poId);

        if (po != null)
        {
            _formLines = po.Items
                .Where(i => i.ReceivedQuantity < i.Quantity)
                .Select(i => new CreateGrnLineModel
                {
                    PoItemId = i.Id,
                    ProductId = i.ProductId,
                    ProductSku = i.Product.Sku,
                    ProductName = i.Product.Name,
                    RemainingQuantity = i.Quantity - i.ReceivedQuantity,
                    QuantityReceived = i.Quantity - i.ReceivedQuantity
                })
                .ToList();
        }
    }

    private async Task SaveCreate()
    {
        if (_formWarehouseId == Guid.Empty || _formPoId == Guid.Empty || string.IsNullOrWhiteSpace(_formDeliveryNoteNumber))
        {
            Snackbar.Add("Mohon lengkapi gudang, PO, dan nomor surat jalan vendor.", Severity.Warning);
            return;
        }

        var linesToReceive = _formLines.Where(l => l.QuantityReceived > 0).ToList();
        if (linesToReceive.Count == 0)
        {
            Snackbar.Add("Kuantitas penerimaan minimal 1 item harus lebih dari 0.", Severity.Warning);
            return;
        }

        var companyId = CurrentUser.CompanyId != Guid.Empty
            ? CurrentUser.CompanyId
            : (await DbContext.Companies.AsNoTracking().FirstOrDefaultAsync())?.Id ?? Guid.Empty;

        var branchId = CurrentUser.BranchId != Guid.Empty
            ? CurrentUser.BranchId
            : (await DbContext.Branches.AsNoTracking().FirstOrDefaultAsync())?.Id ?? Guid.Empty;

        if (companyId == Guid.Empty || branchId == Guid.Empty)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreateGoodsReceiptCommand(
            CompanyId: companyId,
            BranchId: branchId,
            WarehouseId: _formWarehouseId,
            PurchaseOrderId: _formPoId,
            DeliveryNoteNumber: _formDeliveryNoteNumber,
            ReceiptDate: DateOnly.FromDateTime(_formReceiptDate ?? DateTime.Today),
            Items: linesToReceive.Select(l => new GrnItemInput(l.PoItemId, l.ProductId, l.QuantityReceived)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Goods Receipt berhasil dibuat.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task ReceiveGrn(GoodsReceiptDto grn)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Penerimaan Fisik",
            $"Konfirmasi penerimaan fisik GRN {grn.ReceiptNumber}? Stok barang akan otomatis masuk ke gudang '{grn.WarehouseName}' dan jurnal persediaan akan diposting.",
            yesText: "Terima & Update Stok",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new ReceiveGoodsReceiptCommand(grn.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"GRN {grn.ReceiptNumber} berhasil diterima dan stok gudang telah diperbarui.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }
}
