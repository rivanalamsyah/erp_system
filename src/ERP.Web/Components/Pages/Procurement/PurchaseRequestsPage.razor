@page "/procurement/requests"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Purchase Requests - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Purchase Requests</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola permintaan pengadaan barang dan material antar departemen
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Buat PR Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor PR atau catatan..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_requests"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. PR</MudTh>
                    <MudTh>Tgl Pengajuan</MudTh>
                    <MudTh>Dibutuhkan</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Total Est. Biaya</MudTh>
                    <MudTh>Catatan</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. PR">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.RequestNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Tgl Pengajuan">@context.RequestDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Dibutuhkan">@context.RequiredDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Total Est. Biaya">
                        <MudText Typo="Typo.body2" Class="fw-semibold">
                            Rp @context.TotalEstimatedAmount.ToString("N0")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Catatan">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(context.Notes) ? "-" : context.Notes)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       Title="Lihat Detail Item"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft" || context.Status == "PendingApproval")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           Title="Setujui PR"
                                           OnClick="@(() => ApprovePr(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data Purchase Request.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail Purchase Request: @_selectedPr?.RequestNumber</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedPr != null)
        {
            <MudTable Items="@_selectedPr.Items" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Nama Produk</MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align: right;">Kuantitas</MudTh>
                    <MudTh Style="text-align: right;">Est. Harga Satuan</MudTh>
                    <MudTh Style="text-align: right;">Est. Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductSku</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.UomCode</MudTd>
                    <MudTd Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd Style="text-align: right;">Rp @context.EstimatedUnitPrice.ToString("N0")</MudTd>
                    <MudTd Style="text-align: right;">Rp @context.EstimatedTotal.ToString("N0")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Buat Purchase Request Baru</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Pengajuan" @bind-Date="_formRequestDate" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Dibutuhkan" @bind-Date="_formRequiredDate" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_formNotes" Label="Catatan Pengadaan" Lines="2" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Item Produk</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddFormLine">
                        Tambah Baris
                    </MudButton>
                </div>

                @foreach (var line in _formLines)
                {
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudSelect T="Guid" Label="Produk" @bind-Value="line.ProductId" Dense="true" Style="min-width: 250px;">
                            @foreach (var prod in _availableProducts)
                            {
                                <MudSelectItem Value="@prod.Id">@prod.Name (@prod.Sku)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" Label="Qty" @bind-Value="line.Quantity" Min="0.01m" Dense="true" Style="width: 100px;" />
                        <MudNumericField T="decimal" Label="Est. Harga" @bind-Value="line.EstimatedUnitPrice" Min="0m" Dense="true" Style="width: 150px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _formLines.Remove(line))" Disabled="@(_formLines.Count <= 1)" />
                    </div>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan PR</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PurchaseRequestDto> _requests = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private PurchaseRequestDto? _selectedPr;

    private bool _createOpen = false;
    private DateTime? _formRequestDate = DateTime.Today;
    private DateTime? _formRequiredDate = DateTime.Today.AddDays(7);
    private string? _formNotes;
    private List<CreateLineModel> _formLines = [];
    private List<ProductSummary> _availableProducts = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreateLineModel
    {
        public Guid ProductId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal EstimatedUnitPrice { get; set; }
    }

    public record ProductSummary(Guid Id, string Sku, string Name, decimal BasePrice);

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        await LoadData();
    }

    private async Task LoadProducts()
    {
        _availableProducts = await DbContext.Products
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.Name)
            .Select(p => new ProductSummary(p.Id, p.Sku, p.Name, p.PurchasePrice))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetPurchaseRequestsQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _requests = result.Value.Items.ToList();
                _totalPages = (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize);
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(PurchaseRequestDto pr)
    {
        _selectedPr = pr;
        _detailsOpen = true;
    }

    private void OpenCreateDialog()
    {
        _formRequestDate = DateTime.Today;
        _formRequiredDate = DateTime.Today.AddDays(7);
        _formNotes = string.Empty;
        _formLines =
        [
            new CreateLineModel
            {
                ProductId = _availableProducts.FirstOrDefault()?.Id ?? Guid.Empty,
                Quantity = 1,
                EstimatedUnitPrice = _availableProducts.FirstOrDefault()?.BasePrice ?? 0
            }
        ];
        _createOpen = true;
    }

    private void AddFormLine()
    {
        _formLines.Add(new CreateLineModel
        {
            ProductId = _availableProducts.FirstOrDefault()?.Id ?? Guid.Empty,
            Quantity = 1,
            EstimatedUnitPrice = 0
        });
    }

    private async Task SaveCreate()
    {
        if (_formLines.Count == 0 || _formLines.Any(l => l.ProductId == Guid.Empty || l.Quantity <= 0))
        {
            Snackbar.Add("Mohon lengkapi baris item produk dengan kuantitas valid.", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreatePurchaseRequestCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            RequestDate: DateOnly.FromDateTime(_formRequestDate ?? DateTime.Today),
            RequiredDate: DateOnly.FromDateTime(_formRequiredDate ?? DateTime.Today),
            Notes: _formNotes,
            Items: _formLines.Select(l => new PrItemInput(l.ProductId, l.Quantity, l.EstimatedUnitPrice)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Purchase Request berhasil diajukan.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task ApprovePr(PurchaseRequestDto pr)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Persetujuan",
            $"Apakah Anda yakin ingin menyetujui Purchase Request {pr.RequestNumber}?",
            yesText: "Setujui",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new ApprovePurchaseRequestCommand(pr.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"PR {pr.RequestNumber} berhasil disetujui.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "PendingApproval" => Color.Warning,
        "Approved" => Color.Success,
        "Rejected" => Color.Error,
        "Closed" => Color.Info,
        _ => Color.Default
    };
}
