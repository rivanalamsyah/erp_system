@page "/sales/deliveries"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Surat Jalan (Deliveries) - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Surat Jalan (Delivery Orders)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola pengiriman fisik barang dari gudang ke alamat pelanggan dan pemotongan stok otomatis
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Buat Surat Jalan Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor DO, nomor SO, atau pelanggan..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_deliveries"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. DO</MudTh>
                    <MudTh>Pelanggan</MudTh>
                    <MudTh>Ref. SO</MudTh>
                    <MudTh>Gudang Asal</MudTh>
                    <MudTh>Tgl Pengiriman</MudTh>
                    <MudTh>No. Resi / Armada</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. DO">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.DeliveryNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Pelanggan">@context.CustomerName</MudTd>
                    <MudTd DataLabel="Ref. SO">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.OrderNumber</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Gudang">@context.WarehouseName</MudTd>
                    <MudTd DataLabel="Tgl Kirim">@context.DeliveryDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="No. Resi">@(string.IsNullOrWhiteSpace(context.TrackingNumber) ? "-" : context.TrackingNumber)</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.LocalShipping"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => DispatchDelivery(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data Surat Jalan.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail Surat Jalan: @_selectedDelivery?.DeliveryNumber (SO: @_selectedDelivery?.OrderNumber)</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedDelivery != null)
        {
            <MudTable Items="@_selectedDelivery.Items" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Nama Produk</MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align: right;">Kuantitas Dikirim</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductSku</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.UomCode</MudTd>
                    <MudTd Style="text-align: right;" Class="fw-bold">@context.QuantityShipped.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Penerbitan Surat Jalan (Delivery Order)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Gudang Asal Pengeluaran" @bind-Value="_formWarehouseId" Required="true">
                    @foreach (var wh in _availableWarehouses)
                    {
                        <MudSelectItem Value="@wh.Id">@wh.Name (@wh.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Pilih Sales Order (Confirmed)" Value="_formSoId" ValueChanged="OnSoChanged" Required="true">
                    @foreach (var so in _openSalesOrders)
                    {
                        <MudSelectItem Value="@so.Id">@so.OrderNumber - @so.CustomerName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Tanggal Pengiriman" @bind-Date="_formDeliveryDate" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_formTrackingNumber" Label="No. Resi Ekspedisi / Plat Armada Truk" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Item Barang yang Dikirim</MudText>

                @if (_formLines.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Pilih Sales Order di atas untuk memuat daftar produk yang siap dikirim.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_formLines" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Produk</MudTh>
                            <MudTh Style="text-align: right;">Sisa Belum Dikirim</MudTh>
                            <MudTh Style="text-align: right;">Qty Dikirim Saat Ini</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ProductName (@context.ProductSku)</MudTd>
                            <MudTd Style="text-align: right;">@context.RemainingQuantity.ToString("N2")</MudTd>
                            <MudTd Style="text-align: right; width: 160px;">
                                <MudNumericField T="decimal" @bind-Value="context.QuantityShipped" Min="0" Max="@context.RemainingQuantity" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan Surat Jalan</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<DeliveryDto> _deliveries = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private DeliveryDto? _selectedDelivery;

    private bool _createOpen = false;
    private Guid _formWarehouseId;
    private Guid _formSoId;
    private DateTime? _formDeliveryDate = DateTime.Today;
    private string? _formTrackingNumber;
    private List<CreateDeliveryLineModel> _formLines = [];

    private List<WarehouseSummary> _availableWarehouses = [];
    private List<OpenSoSummary> _openSalesOrders = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreateDeliveryLineModel
    {
        public Guid SoItemId { get; set; }
        public Guid ProductId { get; set; }
        public string ProductSku { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public decimal RemainingQuantity { get; set; }
        public decimal QuantityShipped { get; set; }
    }

    public record WarehouseSummary(Guid Id, string Code, string Name);
    public record OpenSoSummary(Guid Id, string OrderNumber, string CustomerName);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        _availableWarehouses = await DbContext.Warehouses
            .AsNoTracking()
            .Where(w => w.IsActive)
            .OrderBy(w => w.Name)
            .Select(w => new WarehouseSummary(w.Id, w.Code, w.Name))
            .ToListAsync();

        _openSalesOrders = await DbContext.SalesOrders
            .AsNoTracking()
            .Where(s => s.Status == SalesOrderStatus.Confirmed || s.Status == SalesOrderStatus.PartiallyShipped)
            .OrderByDescending(s => s.OrderDate)
            .Select(s => new OpenSoSummary(s.Id, s.OrderNumber, s.Customer.Name))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetDeliveriesQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _deliveries = result.Value.Items.ToList();
                _totalPages = (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize);
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat Surat Jalan: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(DeliveryDto d)
    {
        _selectedDelivery = d;
        _detailsOpen = true;
    }

    private async Task OpenCreateDialog()
    {
        await LoadLookups();
        _formWarehouseId = _availableWarehouses.FirstOrDefault()?.Id ?? Guid.Empty;
        _formSoId = _openSalesOrders.FirstOrDefault()?.Id ?? Guid.Empty;
        _formDeliveryDate = DateTime.Today;
        _formTrackingNumber = string.Empty;
        _formLines.Clear();

        if (_formSoId != Guid.Empty)
        {
            await OnSoChanged(_formSoId);
        }

        _createOpen = true;
    }

    private async Task OnSoChanged(Guid soId)
    {
        _formSoId = soId;
        _formLines.Clear();

        if (soId == Guid.Empty) return;

        var so = await DbContext.SalesOrders
            .Include(s => s.Items)
                .ThenInclude(i => i.Product)
            .AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == soId);

        if (so != null)
        {
            _formLines = so.Items
                .Where(i => i.ShippedQuantity < i.Quantity)
                .Select(i => new CreateDeliveryLineModel
                {
                    SoItemId = i.Id,
                    ProductId = i.ProductId,
                    ProductSku = i.Product.Sku,
                    ProductName = i.Product.Name,
                    RemainingQuantity = i.Quantity - i.ShippedQuantity,
                    QuantityShipped = i.Quantity - i.ShippedQuantity
                })
                .ToList();
        }
    }

    private async Task SaveCreate()
    {
        if (_formWarehouseId == Guid.Empty || _formSoId == Guid.Empty)
        {
            Snackbar.Add("Mohon pilih gudang asal dan Sales Order.", Severity.Warning);
            return;
        }

        var linesToShip = _formLines.Where(l => l.QuantityShipped > 0).ToList();
        if (linesToShip.Count == 0)
        {
            Snackbar.Add("Kuantitas pengiriman minimal 1 item harus lebih dari 0.", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreateDeliveryCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            WarehouseId: _formWarehouseId,
            SalesOrderId: _formSoId,
            DeliveryDate: DateOnly.FromDateTime(_formDeliveryDate ?? DateTime.Today),
            TrackingNumber: _formTrackingNumber,
            Items: linesToShip.Select(l => new DeliveryItemInput(l.SoItemId, l.ProductId, l.QuantityShipped)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Surat Jalan berhasil dibuat.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task DispatchDelivery(DeliveryDto d)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Keberangkatan Pengiriman",
            $"Dispatch Surat Jalan {d.DeliveryNumber}? Stok barang akan otomatis dipotong keluar dari gudang '{d.WarehouseName}' dan status pengiriman SO akan diperbarui.",
            yesText: "Dispatch & Potong Stok",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new DispatchDeliveryCommand(d.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"Surat Jalan {d.DeliveryNumber} berhasil didispatch dan persediaan telah dipotong.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Dispatched" => Color.Warning,
        "Delivered" => Color.Success,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };
}

