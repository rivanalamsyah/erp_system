@page "/sales/quotations"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Sales Quotations - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Penawaran Harga (Sales Quotation)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola surat penawaran harga resmi kepada prospek dan pelanggan
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Buat Penawaran Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor penawaran atau pelanggan..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_quotations"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. SQ</MudTh>
                    <MudTh>Pelanggan</MudTh>
                    <MudTh>Tgl Penawaran</MudTh>
                    <MudTh>Berlaku Hingga</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Subtotal</MudTh>
                    <MudTh Style="text-align: right;">PPN (11%)</MudTh>
                    <MudTh Style="text-align: right;">Total Nilai SQ</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. SQ">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.QuotationNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Pelanggan">@context.CustomerName</MudTd>
                    <MudTd DataLabel="Tgl Penawaran">@context.QuotationDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Berlaku Hingga">@context.ExpirationDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Subtotal" Style="text-align: right;">Rp @context.SubtotalAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="PPN" Style="text-align: right;">Rp @context.TaxAmount.ToString("N0")</MudTd>
                    <MudTd DataLabel="Total Nilai SQ" Style="text-align: right;">
                        <MudText Typo="Typo.body2" Class="fw-bold">
                            Rp @context.TotalAmount.ToString("N0")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft" || context.Status == "Sent")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => ApproveQuotation(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada data Sales Quotation.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail Penawaran: @_selectedQuotation?.QuotationNumber - @_selectedQuotation?.CustomerName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedQuotation != null)
        {
            <MudTable Items="@_selectedQuotation.Items" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>SKU</MudTh>
                    <MudTh>Nama Produk</MudTh>
                    <MudTh>Satuan</MudTh>
                    <MudTh Style="text-align: right;">Qty</MudTh>
                    <MudTh Style="text-align: right;">Harga Satuan</MudTh>
                    <MudTh Style="text-align: right;">Diskon %</MudTh>
                    <MudTh Style="text-align: right;">Total Baris</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ProductSku</MudTd>
                    <MudTd>@context.ProductName</MudTd>
                    <MudTd>@context.UomCode</MudTd>
                    <MudTd Style="text-align: right;">@context.Quantity.ToString("N2")</MudTd>
                    <MudTd Style="text-align: right;">Rp @context.UnitPrice.ToString("N0")</MudTd>
                    <MudTd Style="text-align: right;">@context.DiscountRate.ToString("N1")%</MudTd>
                    <MudTd Style="text-align: right;" Class="fw-semibold">Rp @context.LineTotal.ToString("N0")</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Buat Sales Quotation Baru</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Label="Pelanggan / Customer" @bind-Value="_formCustomerId" Required="true">
                    @foreach (var c in _availableCustomers)
                    {
                        <MudSelectItem Value="@c.Id">@c.Name (@c.Code)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Tanggal Penawaran" @bind-Date="_formQuotationDate" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker Label="Berlaku Hingga" @bind-Date="_formExpirationDate" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Item Produk Penawaran</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddFormLine">
                        Tambah Baris
                    </MudButton>
                </div>

                @foreach (var line in _formLines)
                {
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudSelect T="Guid" Label="Produk" Value="line.ProductId" ValueChanged="@((Guid id) => OnProductSelected(line, id))" Dense="true" Style="min-width: 220px;">
                            @foreach (var prod in _availableProducts)
                            {
                                <MudSelectItem Value="@prod.Id">@prod.Name (@prod.Sku)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" Label="Qty" @bind-Value="line.Quantity" Min="0.01m" Style="width: 80px;" />
                        <MudNumericField T="decimal" Label="Harga Jual" @bind-Value="line.UnitPrice" Min="0m" Style="width: 140px;" />
                        <MudNumericField T="decimal" Label="Disc %" @bind-Value="line.DiscountRate" Min="0m" Max="100m" Style="width: 80px;" />
                        <MudText Typo="Typo.body2" Class="fw-semibold px-2" Style="min-width: 120px; text-align: right;">
                            Rp @((line.Quantity * line.UnitPrice * (1 - (line.DiscountRate / 100m))).ToString("N0"))
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _formLines.Remove(line))" Disabled="@(_formLines.Count <= 1)" />
                    </div>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan Penawaran</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<QuotationDto> _quotations = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private QuotationDto? _selectedQuotation;

    private bool _createOpen = false;
    private Guid _formCustomerId;
    private DateTime? _formQuotationDate = DateTime.Today;
    private DateTime? _formExpirationDate = DateTime.Today.AddDays(14);
    private List<CreateLineModel> _formLines = [];

    private List<CustomerSummary> _availableCustomers = [];
    private List<ProductSummary> _availableProducts = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreateLineModel
    {
        public Guid ProductId { get; set; }
        public decimal Quantity { get; set; } = 1;
        public decimal UnitPrice { get; set; }
        public decimal DiscountRate { get; set; }
    }

    public record CustomerSummary(Guid Id, string Code, string Name);
    public record ProductSummary(Guid Id, string Sku, string Name, decimal SellingPrice);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        _availableCustomers = await DbContext.Customers
            .AsNoTracking()
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .Select(c => new CustomerSummary(c.Id, c.Code, c.Name))
            .ToListAsync();

        _availableProducts = await DbContext.Products
            .AsNoTracking()
            .Where(p => p.IsActive)
            .OrderBy(p => p.Name)
            .Select(p => new ProductSummary(p.Id, p.Sku, p.Name, p.SellingPrice))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetQuotationsQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _quotations = result.Value.Items.ToList();
                _totalPages = (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize);
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat SQ: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(QuotationDto sq)
    {
        _selectedQuotation = sq;
        _detailsOpen = true;
    }

    private void OpenCreateDialog()
    {
        _formCustomerId = _availableCustomers.FirstOrDefault()?.Id ?? Guid.Empty;
        _formQuotationDate = DateTime.Today;
        _formExpirationDate = DateTime.Today.AddDays(14);

        var firstProd = _availableProducts.FirstOrDefault();
        _formLines =
        [
            new CreateLineModel
            {
                ProductId = firstProd?.Id ?? Guid.Empty,
                Quantity = 1,
                UnitPrice = firstProd?.SellingPrice ?? 0,
                DiscountRate = 0
            }
        ];
        _createOpen = true;
    }

    private void OnProductSelected(CreateLineModel line, Guid productId)
    {
        line.ProductId = productId;
        var p = _availableProducts.FirstOrDefault(x => x.Id == productId);
        if (p != null)
        {
            line.UnitPrice = p.SellingPrice;
        }
    }

    private void AddFormLine()
    {
        var firstProd = _availableProducts.FirstOrDefault();
        _formLines.Add(new CreateLineModel
        {
            ProductId = firstProd?.Id ?? Guid.Empty,
            Quantity = 1,
            UnitPrice = firstProd?.SellingPrice ?? 0,
            DiscountRate = 0
        });
    }

    private async Task SaveCreate()
    {
        if (_formCustomerId == Guid.Empty)
        {
            Snackbar.Add("Silakan pilih pelanggan/customer.", Severity.Warning);
            return;
        }

        if (_formLines.Count == 0 || _formLines.Any(l => l.ProductId == Guid.Empty || l.Quantity <= 0))
        {
            Snackbar.Add("Mohon lengkapi baris item produk SQ dengan kuantitas valid.", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreateQuotationCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            CustomerId: _formCustomerId,
            QuotationDate: DateOnly.FromDateTime(_formQuotationDate ?? DateTime.Today),
            ExpirationDate: DateOnly.FromDateTime(_formExpirationDate ?? DateTime.Today.AddDays(14)),
            Items: _formLines.Select(l => new QuotationItemInput(l.ProductId, l.Quantity, l.UnitPrice, l.DiscountRate)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Sales Quotation berhasil dibuat.", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task ApproveQuotation(QuotationDto sq)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Persetujuan Penawaran",
            $"Apakah Anda yakin ingin menyetujui penawaran harga {sq.QuotationNumber} senilai Rp {sq.TotalAmount:N0}?",
            yesText: "Setujui",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new ApproveQuotationCommand(sq.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"SQ {sq.QuotationNumber} berhasil disetujui.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Draft" => Color.Default,
        "Sent" => Color.Info,
        "Approved" => Color.Success,
        "Converted" => Color.Primary,
        "Rejected" => Color.Error,
        "Expired" => Color.Dark,
        _ => Color.Default
    };
}

