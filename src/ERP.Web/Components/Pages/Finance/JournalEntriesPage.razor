@page "/finance/journals"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Jurnal Umum (Journal Entries) - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Jurnal Umum & Buku Besar (General Ledger)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kelola pencatatan ayat jurnal akuntansi berpasangan (Double-Entry Invariant: Total Debit = Total Kredit)
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Input Jurnal Baru
        </MudButton>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <div class="d-flex gap-4 mb-4">
                <MudTextField @bind-Value="_searchTerm"
                              Placeholder="Cari nomor jurnal, referensi, atau keterangan..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0"
                              Immediate="true"
                              OnKeyUp="OnSearchKeyUp" />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData">
                    Refresh
                </MudButton>
            </div>

            <MudTable Items="@_entries"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>No. Jurnal</MudTh>
                    <MudTh>Tgl Jurnal</MudTh>
                    <MudTh>Tipe Ref</MudTh>
                    <MudTh>No. Referensi</MudTh>
                    <MudTh>Keterangan</MudTh>
                    <MudTh Style="text-align: right;">Total Debit</MudTh>
                    <MudTh Style="text-align: right;">Total Kredit</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Aksi</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="No. Jurnal">
                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@context.JournalNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Tgl Jurnal">@context.JournalDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Tipe Ref">@context.ReferenceType</MudTd>
                    <MudTd DataLabel="No. Referensi">@context.ReferenceNumber</MudTd>
                    <MudTd DataLabel="Keterangan">@context.Description</MudTd>
                    <MudTd DataLabel="Total Debit" Style="text-align: right;">Rp @context.TotalDebit.ToString("N0")</MudTd>
                    <MudTd DataLabel="Total Kredit" Style="text-align: right;">Rp @context.TotalCredit.ToString("N0")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Status == "Posted" ? Color.Success : Color.Warning)">
                            @context.Status
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       OnClick="@(() => ShowDetails(context))" />
                        @if (context.Status == "Draft")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           OnClick="@(() => PostJournal(context))" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada transaksi jurnal.</MudText>
                </NoRecordsContent>
            </MudTable>

            <div class="d-flex justify-end mt-4">
                <MudPagination Count="@_totalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary" />
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@* Detail Dialog *@
<MudDialog @bind-Visible="_detailsOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Detail Jurnal: @_selectedEntry?.JournalNumber - @_selectedEntry?.Description</MudText>
    </TitleContent>
    <DialogContent>
        @if (_selectedEntry != null)
        {
            <MudTable Items="@_selectedEntry.Lines" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Kode Akun</MudTh>
                    <MudTh>Nama Akun</MudTh>
                    <MudTh>Keterangan Baris</MudTh>
                    <MudTh Style="text-align: right;">Debit</MudTh>
                    <MudTh Style="text-align: right;">Kredit</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode</MudTd>
                    <MudTd>@context.AccountName</MudTd>
                    <MudTd>@(string.IsNullOrWhiteSpace(context.Description) ? "-" : context.Description)</MudTd>
                    <MudTd Style="text-align: right;">@(context.Debit > 0 ? $"Rp {context.Debit:N0}" : "-")</MudTd>
                    <MudTd Style="text-align: right;">@(context.Credit > 0 ? $"Rp {context.Credit:N0}" : "-")</MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTh colspan="3" Style="text-align: right; font-weight: bold;">TOTAL:</MudTh>
                    <MudTh Style="text-align: right; font-weight: bold;">Rp @_selectedEntry.TotalDebit.ToString("N0")</MudTh>
                    <MudTh Style="text-align: right; font-weight: bold;">Rp @_selectedEntry.TotalCredit.ToString("N0")</MudTh>
                </FooterContent>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => _detailsOpen = false)">Tutup</MudButton>
    </DialogActions>
</MudDialog>

@* Create Dialog *@
<MudDialog @bind-Visible="_createOpen" Options="_largeDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Pencatatan Ayat Jurnal Umum</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudDatePicker Label="Tanggal Jurnal" @bind-Date="_formJournalDate" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_formReferenceType" Label="Tipe Referensi" Placeholder="Manual / Penyesuaian" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="_formReferenceNumber" Label="Nomor Bukti / Ref" Placeholder="MEMO-001" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_formDescription" Label="Keterangan Jurnal" Required="true" />
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Baris Jurnal (Double-Entry Debit & Kredit)</MudText>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="AddFormLine">
                        Tambah Baris
                    </MudButton>
                </div>

                @foreach (var line in _formLines)
                {
                    <div class="d-flex gap-2 align-center mb-2">
                        <MudSelect T="Guid" Label="Akun COA" @bind-Value="line.AccountId" Dense="true" Style="min-width: 250px;">
                            @foreach (var acc in _availableAccounts)
                            {
                                <MudSelectItem Value="@acc.Id">@acc.AccountCode - @acc.AccountName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="decimal" Label="Debit (Rp)" @bind-Value="line.Debit" Min="0" Style="width: 140px;" />
                        <MudNumericField T="decimal" Label="Kredit (Rp)" @bind-Value="line.Credit" Min="0" Style="width: 140px;" />
                        <MudTextField @bind-Value="line.Description" Label="Keterangan" Style="min-width: 160px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => _formLines.Remove(line))" Disabled="@(_formLines.Count <= 2)" />
                    </div>
                }

                <div class="d-flex justify-space-between align-center p-3 mt-3 rounded" style="background-color: var(--mud-palette-background-grey);">
                    <div>
                        <MudText Typo="Typo.body2">Total Debit: <strong>Rp @(_formLines.Sum(l => l.Debit).ToString("N0"))</strong></MudText>
                        <MudText Typo="Typo.body2">Total Kredit: <strong>Rp @(_formLines.Sum(l => l.Credit).ToString("N0"))</strong></MudText>
                    </div>
                    <div>
                        @{
                            var diff = Math.Abs(_formLines.Sum(l => l.Debit) - _formLines.Sum(l => l.Credit));
                        }
                        @if (diff == 0 && _formLines.Sum(l => l.Debit) > 0)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Check">Jurnal Seimbang (Balance)</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                Selisih: Rp @diff.ToString("N0") (Tidak Seimbang)
                            </MudChip>
                        }
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">Batal</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCreate">Simpan Jurnal</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<JournalEntryDto> _entries = [];
    private bool _loading = true;
    private string _searchTerm = string.Empty;
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalPages = 1;

    private bool _detailsOpen = false;
    private JournalEntryDto? _selectedEntry;

    private bool _createOpen = false;
    private DateTime? _formJournalDate = DateTime.Today;
    private string _formReferenceType = "Manual";
    private string _formReferenceNumber = string.Empty;
    private string _formDescription = string.Empty;
    private List<CreateLineModel> _formLines = [];

    private List<AccountLookup> _availableAccounts = [];

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };
    private readonly DialogOptions _largeDialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true };

    public class CreateLineModel
    {
        public Guid AccountId { get; set; }
        public decimal Debit { get; set; }
        public decimal Credit { get; set; }
        public string? Description { get; set; }
    }

    public record AccountLookup(Guid Id, string AccountCode, string AccountName);

    protected override async Task OnInitializedAsync()
    {
        await LoadAccounts();
        await LoadData();
    }

    private async Task LoadAccounts()
    {
        _availableAccounts = await DbContext.ChartOfAccounts
            .AsNoTracking()
            .Where(a => a.IsActive && !a.IsHeader)
            .OrderBy(a => a.AccountCode)
            .Select(a => new AccountLookup(a.Id, a.AccountCode, a.AccountName))
            .ToListAsync();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetJournalEntriesQuery(
                SearchTerm: _searchTerm,
                PageNumber: _currentPage,
                PageSize: _pageSize));

            if (result.IsSuccess)
            {
                _entries = result.Value.Items.ToList();
                _totalPages = (int)Math.Ceiling((double)result.Value.TotalCount / _pageSize);
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat jurnal: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _currentPage = 1;
            await LoadData();
        }
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page;
        await LoadData();
    }

    private void ShowDetails(JournalEntryDto j)
    {
        _selectedEntry = j;
        _detailsOpen = true;
    }

    private void OpenCreateDialog()
    {
        _formJournalDate = DateTime.Today;
        _formReferenceType = "Manual";
        _formReferenceNumber = "MEMO-" + DateTime.Now.ToString("yyMMddHHmm");
        _formDescription = string.Empty;

        var acc1 = _availableAccounts.FirstOrDefault();
        var acc2 = _availableAccounts.Skip(1).FirstOrDefault();

        _formLines =
        [
            new CreateLineModel { AccountId = acc1?.Id ?? Guid.Empty, Debit = 0, Credit = 0 },
            new CreateLineModel { AccountId = acc2?.Id ?? Guid.Empty, Debit = 0, Credit = 0 }
        ];
        _createOpen = true;
    }

    private void AddFormLine()
    {
        var acc = _availableAccounts.FirstOrDefault();
        _formLines.Add(new CreateLineModel { AccountId = acc?.Id ?? Guid.Empty, Debit = 0, Credit = 0 });
    }

    private async Task SaveCreate()
    {
        if (string.IsNullOrWhiteSpace(_formDescription))
        {
            Snackbar.Add("Keterangan jurnal wajib diisi.", Severity.Warning);
            return;
        }

        var totalDebit = _formLines.Sum(l => l.Debit);
        var totalCredit = _formLines.Sum(l => l.Credit);

        if (totalDebit == 0 || totalCredit == 0 || totalDebit != totalCredit)
        {
            Snackbar.Add($"BR-ACC-001: Keseimbangan jurnal dilanggar. Total Debit (Rp {totalDebit:N0}) != Total Kredit (Rp {totalCredit:N0}).", Severity.Warning);
            return;
        }

        var company = await DbContext.Companies.FirstOrDefaultAsync();
        var branch = await DbContext.Branches.FirstOrDefaultAsync();

        if (company == null || branch == null)
        {
            Snackbar.Add("Master Company / Branch belum terkonfigurasi.", Severity.Error);
            return;
        }

        var command = new CreateJournalEntryCommand(
            CompanyId: company.Id,
            BranchId: branch.Id,
            JournalDate: DateOnly.FromDateTime(_formJournalDate ?? DateTime.Today),
            ReferenceType: _formReferenceType,
            ReferenceNumber: _formReferenceNumber,
            Description: _formDescription,
            Lines: _formLines.Select(l => new JournalLineInput(l.AccountId, l.Debit, l.Credit, l.Description)).ToList()
        );

        var result = await Mediator.Send(command);
        if (result.IsSuccess)
        {
            Snackbar.Add("Ayat jurnal umum berhasil disimpan (Draft).", Severity.Success);
            _createOpen = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(result.Error.Description, Severity.Error);
        }
    }

    private async Task PostJournal(JournalEntryDto j)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Posting Jurnal Buku Besar",
            $"Posting permanen jurnal {j.JournalNumber} senilai Rp {j.TotalDebit:N0} ke buku besar? Tindakan ini akan mengunci ayat jurnal secara permanen.",
            yesText: "Posting Jurnal",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new PostJournalEntryCommand(j.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"Jurnal {j.JournalNumber} berhasil diposting ke Buku Besar.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }
}

