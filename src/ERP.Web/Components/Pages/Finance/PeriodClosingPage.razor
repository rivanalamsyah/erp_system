@page "/finance/period-closing"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ISender Mediator
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ICurrentUserService CurrentUser
@inject IApplicationDbContext DbContext

<PageTitle>Tutup Periode Fiskal - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex justify-space-between align-center mb-6">
        <div>
            <MudText Typo="Typo.h5" Class="fw-bold">Manajemen Periode Fiskal & Tutup Buku</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Kunci periode akuntansi untuk mencegah perubahan atau pemostingan transaksi lampau (BR-ACC-002)
            </MudText>
        </div>
        <div class="d-flex gap-2">
            <MudNumericField T="int" Label="Tahun Fiskal" Value="_selectedYear" ValueChanged="OnYearChanged" Min="2020" Max="2035" Style="width: 140px;" />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="LoadData">
                Refresh
            </MudButton>
        </div>
    </div>

    <MudCard Elevation="2" Class="erp-card">
        <MudCardContent>
            <MudTable Items="@_periods"
                      Loading="@_loading"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Elevation="0">
                <HeaderContent>
                    <MudTh>Periode (Bulan)</MudTh>
                    <MudTh>Tahun Fiskal</MudTh>
                    <MudTh>Tanggal Mulai</MudTh>
                    <MudTh>Tanggal Berakhir</MudTh>
                    <MudTh>Status Periode</MudTh>
                    <MudTh>Waktu Ditutup</MudTh>
                    <MudTh Style="text-align: right;">Aksi Kontrol</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Periode">
                        <MudText Typo="Typo.body2" Class="fw-bold">Bulan @context.PeriodNumber</MudText>
                    </MudTd>
                    <MudTd DataLabel="Tahun">@context.FiscalYear</MudTd>
                    <MudTd DataLabel="Mulai">@context.StartDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Berakhir">@context.EndDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.IsClosed ? Color.Error : Color.Success)">
                            @(context.IsClosed ? "Terkunci (Closed)" : "Terbuka (Open)")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Waktu Ditutup">
                        @(context.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                    </MudTd>
                    <MudTd DataLabel="Aksi" Style="text-align: right;">
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="@(context.IsClosed ? Color.Warning : Color.Error)"
                                   StartIcon="@(context.IsClosed ? Icons.Material.Filled.LockOpen : Icons.Material.Filled.Lock)"
                                   OnClick="@(() => TogglePeriod(context))">
                            @(context.IsClosed ? "Buka Kembali" : "Kunci Periode")
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="py-6">Belum ada periode fiskal untuk tahun ini.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<FiscalPeriodDto> _periods = [];
    private bool _loading = true;
    private int _selectedYear = DateTime.UtcNow.Year;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task OnYearChanged(int year)
    {
        _selectedYear = year;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var result = await Mediator.Send(new GetFiscalPeriodsQuery(_selectedYear));
            if (result.IsSuccess)
            {
                _periods = result.Value.ToList();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Gagal memuat periode fiskal: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TogglePeriod(FiscalPeriodDto period)
    {
        var action = period.IsClosed ? "membuka kembali" : "mengunci (tutup buku)";
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Penguncian Periode Fiskal",
            $"Apakah Anda yakin ingin {action} periode Bulan {period.PeriodNumber}/{period.FiscalYear}? Saat periode terkunci, seluruh pembuatan atau pengubahan transaksi pada rentang tanggal tersebut dilarang (BR-ACC-002).",
            yesText: period.IsClosed ? "Buka Periode" : "Kunci Periode",
            cancelText: "Batal");

        if (confirm == true)
        {
            var result = await Mediator.Send(new ToggleFiscalPeriodCommand(period.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add($"Status periode Bulan {period.PeriodNumber} berhasil diperbarui.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }
}

