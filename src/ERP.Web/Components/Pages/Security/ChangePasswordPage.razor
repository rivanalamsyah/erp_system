@page "/security/change-password"
@attribute [Authorize]
@inject ICurrentUserService CurrentUser
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar
@using ERP.Infrastructure.Identity.Models
@using Microsoft.AspNetCore.Identity

<PageTitle>Ganti Kata Sandi — Enterprise ERP</PageTitle>

<div class="mb-4">
    <MudText Typo="Typo.h5" Style="font-weight: 700; color: #0F172A;">
        Ganti Kata Sandi Akun
    </MudText>
    <MudText Typo="Typo.body2" Style="color: #64748B;">
        Perbarui kata sandi Anda secara berkala untuk menjaga keamanan akses sistem enterprise.
    </MudText>
</div>

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-0">
    <MudCard Elevation="1" Class="rounded-lg border border-slate-200 pa-6">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Kata sandi baru harus memiliki minimal <b>8 karakter</b>, mengandung huruf besar (A-Z), huruf kecil (a-z), angka (0-9), dan simbol khusus (@@, #, $, dll).
        </MudAlert>

        <MudStack Spacing="3">
            <MudTextField Label="Kata Sandi Saat Ini *" @bind-Value="_currentPassword"
                          InputType="InputType.Password" Required="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock" Margin="Margin.Dense" />

            <MudTextField Label="Kata Sandi Baru *" @bind-Value="_newPassword"
                          InputType="InputType.Password" Required="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LockReset" Margin="Margin.Dense" />

            <MudTextField Label="Konfirmasi Kata Sandi Baru *" @bind-Value="_confirmPassword"
                          InputType="InputType.Password" Required="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Check" Margin="Margin.Dense" />

            <div class="d-flex justify-end mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key"
                           OnClick="ChangePasswordAsync" Disabled="@_saving">
                    @if (_saving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Simpan Kata Sandi Baru
                </MudButton>
            </div>
        </MudStack>
    </MudCard>
</MudContainer>

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _saving = false;

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            Snackbar.Add("Semua kolom kata sandi wajib diisi.", Severity.Warning);
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            Snackbar.Add("Konfirmasi kata sandi baru tidak cocok.", Severity.Warning);
            return;
        }

        if (_newPassword.Length < 8)
        {
            Snackbar.Add("Kata sandi baru minimal harus 8 karakter.", Severity.Warning);
            return;
        }

        if (!CurrentUser.UserId.HasValue) return;

        _saving = true;
        try
        {
            var user = await UserManager.FindByIdAsync(CurrentUser.UserId.Value.ToString());
            if (user == null)
            {
                Snackbar.Add("Pengguna tidak ditemukan.", Severity.Error);
                return;
            }

            var result = await UserManager.ChangePasswordAsync(user, _currentPassword, _newPassword);
            if (result.Succeeded)
            {
                Snackbar.Add("Kata sandi Anda berhasil diperbarui.", Severity.Success);
                _currentPassword = string.Empty;
                _newPassword = string.Empty;
                _confirmPassword = string.Empty;
            }
            else
            {
                foreach (var err in result.Errors)
                {
                    Snackbar.Add(err.Description, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Terjadi kesalahan: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}

