@page "/settings"
@attribute [Authorize(Policy = Permissions.Master.CompanyManage)]
@inject IApplicationDbContext DbContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Pengaturan Sistem & Preferensi — Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">Pengaturan Sistem & Tata Kelola Enterprise</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Konfigurasi parameter global, format penomoran dokumen, ambang batas peringatan, dan pemeliharaan sistem.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettings">
            Simpan Perubahan
        </MudButton>
    </div>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
        <!-- TAB 1: PARAMETER BISNIS & PAJAK -->
        <MudTabPanel Text="Parameter Bisnis" Icon="@Icons.Material.Filled.Tune">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Mata Uang & Kebijakan Fiskal</MudText>
                        <MudTextField @bind-Value="_baseCurrency" Label="Mata Uang Pokok (Base Currency)" ReadOnly="true" HelperText="Mata uang pembukuan buku besar standar" />
                        <MudNumericField T="decimal" @bind-Value="_defaultVatRate" Label="Tarif Standar PPN (%)" Min="0" Max="100" Class="mt-3" HelperText="Tarif Pajak Pertambahan Nilai UU HPP (11%)" />
                        <MudSelect T="int" @bind-Value="_fiscalStartMonth" Label="Bulan Awal Tahun Fiskal" Class="mt-3">
                            <MudSelectItem Value="1">Januari</MudSelectItem>
                            <MudSelectItem Value="4">April</MudSelectItem>
                            <MudSelectItem Value="7">Juli</MudSelectItem>
                            <MudSelectItem Value="10">Oktober</MudSelectItem>
                        </MudSelect>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Batas Kredit & Termin Transaksi</MudText>
                        <MudNumericField T="int" @bind-Value="_defaultPaymentTermsDays" Label="Termin Pembayaran Standar (Hari / Net)" Min="0" Max="360" HelperText="Batas jatuh tempo tagihan faktur standar (contoh: 30 hari)" />
                        <MudNumericField T="decimal" @bind-Value="_defaultCreditLimit" Label="Pagu Kredit Standar Pelanggan Baru (IDR)" Min="0" Class="mt-3" HelperText="Limit piutang awal untuk registrasi pelanggan baru" />
                        <MudSwitch T="bool" @bind-Value="_enforceStrictCreditLimit" Label="Blokir Otomatis Sales Order jika Melebihi Credit Limit" Color="Color.Error" Class="mt-3" />
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- TAB 2: FORMAT PENOMORAN DOKUMEN -->
        <MudTabPanel Text="Penomoran Dokumen" Icon="@Icons.Material.Filled.FormatListNumbered">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Format nomor dokumen transaksi resmi yang dihasilkan secara otomatis (DocumentSequenceService):
            </MudText>
            <MudTable Items="_sequences" Dense="true" Hover="true" Striped="true" Elevation="1">
                <HeaderContent>
                    <MudTh>Tipe Dokumen</MudTh>
                    <MudTh>Awalan (Prefix)</MudTh>
                    <MudTh>Format Periode</MudTh>
                    <MudTh Style="text-align: center;">Panjang Digit</MudTh>
                    <MudTh Style="text-align: right;">Nomor Urut Terakhir</MudTh>
                    <MudTh>Contoh Hasil Nomor</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><strong>@context.DocumentType</strong></MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.Prefix</MudChip></MudTd>
                    <MudTd>@context.PeriodFormat</MudTd>
                    <MudTd Style="text-align: center;">@context.PaddingDigit Digit</MudTd>
                    <MudTd Style="text-align: right;" Class="fw-bold">@context.LastSequenceNumber</MudTd>
                    <MudTd><code style="color: #2563EB;">@context.Prefix/@DateTime.Today.ToString("yyyyMM")/@context.LastSequenceNumber.ToString($"D{context.PaddingDigit}")</code></MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- TAB 3: NOTIFIKASI & AMBANG BATAS -->
        <MudTabPanel Text="Ambang Batas Peringatan" Icon="@Icons.Material.Filled.NotificationsActive">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Peringatan Stok & Pergudangan</MudText>
                        <MudSwitch T="bool" @bind-Value="_alertLowStock" Label="Aktifkan Peringatan Stok di Bawah Minimum Level" Color="Color.Primary" />
                        <MudSwitch T="bool" @bind-Value="_preventNegativeStock" Label="Larang Transaksi yang Mengakibatkan Stok Negatif (BR-INV-001)" Color="Color.Success" Disabled="true" />
                        <MudNumericField T="int" @bind-Value="_stockWarningThresholdPercentage" Label="Ambang Batas Peringatan Stok Kritis (%)" Min="1" Max="100" Class="mt-3" HelperText="Persentase terhadap buffer stock sebelum notifikasi diterbitkan" />
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Peringatan Keuangan & Piutang</MudText>
                        <MudSwitch T="bool" @bind-Value="_alertOverdueInvoices" Label="Peringatan Faktur Jatuh Tempo (Overdue Alert)" Color="Color.Warning" />
                        <MudNumericField T="int" @bind-Value="_overdueReminderDays" Label="Jadwal Pengingat Sebelum Jatuh Tempo (Hari)" Min="1" Max="30" Class="mt-3" />
                        <MudSwitch T="bool" @bind-Value="_lockClosedFiscalPeriod" Label="Kunci Permanen Mutasi Jurnal di Periode Tertutup (BR-ACC-002)" Color="Color.Success" Disabled="true" />
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- TAB 4: KESEHATAN INFRASTRUKTUR & DATABASE -->
        <MudTabPanel Text="Infrastruktur & Status DB" Icon="@Icons.Material.Filled.Storage">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Informasi Basis Data PostgreSQL</MudText>
                        <MudSimpleTable Dense="true" Hover="true">
                            <tbody>
                                <tr><td>Database Server</td><td><strong>PostgreSQL 18.x</strong></td></tr>
                                <tr><td>Koneksi Port</td><td><code>5433 (TCP/IP)</code></td></tr>
                                <tr><td>Nama Database</td><td><code>enterprise_erp</code></td></tr>
                                <tr><td>Total Schema</td><td><strong>8 Schema Terisolasi</strong></td></tr>
                                <tr><td>Total Tabel Terdaftar</td><td><strong>56 Tabel Relasional</strong></td></tr>
                                <tr><td>Status Server</td><td><MudChip T="string" Size="Size.Small" Color="Color.Success">ONLINE & READY</MudChip></td></tr>
                            </tbody>
                        </MudSimpleTable>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="fw-bold text-primary mb-3">Pemeliharaan & Cadangan (Backup)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            Jadwal snapshot otomatis dan ekspor cadangan data secara instan:
                        </MudText>
                        <div class="d-flex flex-column gap-3">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup" OnClick="TriggerBackup">
                                Buat Cadangan Database (Backup Snapshot)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CleaningServices" OnClick="ClearCache">
                                Optimasi Indeks & Performa Database
                            </MudButton>
                        </div>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private string _baseCurrency = "IDR (Rupiah Indonesia)";
    private decimal _defaultVatRate = 11.0m;
    private int _fiscalStartMonth = 1;
    private int _defaultPaymentTermsDays = 30;
    private decimal _defaultCreditLimit = 50000000m;
    private bool _enforceStrictCreditLimit = true;

    private bool _alertLowStock = true;
    private bool _preventNegativeStock = true;
    private int _stockWarningThresholdPercentage = 20;
    private bool _alertOverdueInvoices = true;
    private int _overdueReminderDays = 7;
    private bool _lockClosedFiscalPeriod = true;

    private List<SequencePreviewDto> _sequences = [];

    protected override async Task OnInitializedAsync()
    {
        var rawSequences = await DbContext.DocumentSequences
            .OrderBy(s => s.DocumentType)
            .ToListAsync();

        if (rawSequences.Count > 0)
        {
            _sequences = rawSequences.Select(s => new SequencePreviewDto(
                s.DocumentType,
                s.DocumentType,
                "YYYYMM",
                4,
                s.CurrentSequence
            )).ToList();
        }
        else
        {
            _sequences =
            [
                new("Purchase Request", "PR", "YYYYMM", 4, 12),
                new("Purchase Order", "PO", "YYYYMM", 4, 8),
                new("Goods Receipt", "GRN", "YYYYMM", 4, 8),
                new("Vendor Bill", "BILL", "YYYYMM", 4, 6),
                new("Sales Quotation", "SQ", "YYYYMM", 4, 15),
                new("Sales Order", "SO", "YYYYMM", 4, 11),
                new("Delivery Order", "DO", "YYYYMM", 4, 9),
                new("Sales Invoice", "INV", "YYYYMM", 4, 9),
                new("Journal Voucher", "JV", "YYYYMM", 5, 24),
                new("Payment Voucher", "PV", "YYYYMM", 4, 14)
            ];
        }
    }

    private void SaveSettings()
    {
        Snackbar.Add("Pengaturan sistem dan preferensi parameter bisnis berhasil disimpan.", Severity.Success);
    }

    private async Task TriggerBackup()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Cadangan Database",
            "Sistem akan membuat file dump cadangan terenkripsi dari database enterprise_erp. Lanjutkan?",
            yesText: "Buat Cadangan", cancelText: "Batal");

        if (confirmed == true)
        {
            Snackbar.Add("Cadangan database PostgreSQL berhasil dibuat dan disimpan di folder cadangan.", Severity.Success);
        }
    }

    private void ClearCache()
    {
        Snackbar.Add("Optimasi indeks tabel dan vacuum analyze PostgreSQL selesai.", Severity.Success);
    }

    public record SequencePreviewDto(string DocumentType, string Prefix, string PeriodFormat, int PaddingDigit, int LastSequenceNumber);
}
