@page "/reports/sales"
@attribute [Authorize(Policy = Permissions.Reports.FinancialView)]
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IApplicationDbContext DbContext

<PageTitle>Analitik & Laporan Penjualan - Enterprise ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <div>
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="fw-bold">Analitik Penjualan & Piutang (Sales & AR)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Monitoring performa omzet penjualan, piutang usaha (AR), dan produk terlaris.</MudText>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
                Segarkan
            </MudButton>
        </div>
    </div>

    <!-- FILTER BAR -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" sm="5">
                    <MudDatePicker @bind-Date="_startDate" Label="Dari Tanggal" />
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudDatePicker @bind-Date="_endDate" Label="Sampai Tanggal" />
                </MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="LoadData">Terapkan</MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (_loading)
    {
        <div class="d-flex justify-center my-8"><MudProgressCircular Color="Color.Primary" Indeterminate="true" /></div>
    }
    else if (_data != null)
    {
        <!-- KPI METRICS -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 bg-primary text-white">
                    <MudText Typo="Typo.caption">TOTAL TAGIHAN FAKTUR (INVOICED)</MudText>
                    <MudText Typo="Typo.h5" Class="fw-bold">Rp @_data.TotalInvoiced.ToString("N0")</MudText>
                    <MudText Typo="Typo.body2">@_data.TotalInvoices Faktur Terbit</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 bg-success text-white">
                    <MudText Typo="Typo.caption">KAS DITERIMA (COLLECTED)</MudText>
                    <MudText Typo="Typo.h5" Class="fw-bold">Rp @_data.TotalCollected.ToString("N0")</MudText>
                    <MudText Typo="Typo.body2">Pembayaran Masuk</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 bg-warning text-dark">
                    <MudText Typo="Typo.caption">SISA PIUTANG (OUTSTANDING AR)</MudText>
                    <MudText Typo="Typo.h5" Class="fw-bold">Rp @_data.TotalOutstandingAr.ToString("N0")</MudText>
                    <MudText Typo="Typo.body2">Menunggu Pembayaran</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 bg-info text-white">
                    <MudText Typo="Typo.caption">TOTAL PESANAN (SALES ORDERS)</MudText>
                    <MudText Typo="Typo.h5" Class="fw-bold">@_data.TotalOrders Pesanan</MudText>
                    <MudText Typo="Typo.body2">Volume Transaksi</MudText>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid>
            <!-- TOP CUSTOMERS -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Top 5 Pelanggan Terbaik (Berdasarkan Omset)</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudTable Items="_data.TopCustomers" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Nama Pelanggan</MudTh>
                                <MudTh Style="text-align: center;">Jumlah Faktur</MudTh>
                                <MudTh Style="text-align: right;">Total Omset (IDR)</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><strong>@context.CustomerName</strong></MudTd>
                                <MudTd Style="text-align: center;">@context.InvoiceCount Transaksi</MudTd>
                                <MudTd Style="text-align: right;" Class="fw-bold text-primary">Rp @context.TotalRevenue.ToString("N0")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Align="Align.Center" Class="pa-4">Belum ada transaksi pelanggan.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- TOP PRODUCTS -->
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Top 5 Produk Paling Laris</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudTable Items="_data.TopProducts" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>SKU / Kode</MudTh>
                                <MudTh>Nama Produk</MudTh>
                                <MudTh Style="text-align: center;">Kuantitas</MudTh>
                                <MudTh Style="text-align: right;">Total Nilai (IDR)</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.ProductCode</MudTd>
                                <MudTd><strong>@context.ProductName</strong></MudTd>
                                <MudTd Style="text-align: center;">@context.TotalQuantitySold.ToString("N0")</MudTd>
                                <MudTd Style="text-align: right;" Class="fw-bold text-success">Rp @context.TotalRevenue.ToString("N0")</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <MudText Align="Align.Center" Class="pa-4">Belum ada data penjualan produk.</MudText>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private Guid _companyId;
    private bool _loading = true;
    private DateTime? _startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _endDate = DateTime.Today;
    private SalesAnalyticsDto? _data;

    protected override async Task OnInitializedAsync()
    {
        var comp = await DbContext.Companies.FirstOrDefaultAsync();
        if (comp != null) _companyId = comp.Id;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        var start = _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : (DateOnly?)null;
        var end = _endDate.HasValue ? DateOnly.FromDateTime(_endDate.Value) : (DateOnly?)null;

        var result = await Sender.Send(new GetSalesAnalyticsQuery(_companyId, start, end));
        if (result.IsSuccess)
        {
            _data = result.Value;
        }
        else
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
        }
        _loading = false;
    }
}
