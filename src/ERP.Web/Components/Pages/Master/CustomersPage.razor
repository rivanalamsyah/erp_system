@page "/master/customers"
@inject ISender Sender
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IApplicationDbContext DbContext
@using ERP.Application.Features.Master.Customers
@using Microsoft.EntityFrameworkCore

<PageTitle>Master Pelanggan — Enterprise ERP</PageTitle>

<div class="mb-4 d-flex justify-space-between align-center">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #0F172A;">
            Master Pelanggan (Customers)
        </MudText>
        <MudText Typo="Typo.body2" Style="color: #64748B;">
            Kelola data pelanggan, limit pagu kredit, termin pembayaran, dan alamat pengiriman.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        Tambah Pelanggan
    </MudButton>
</div>

<MudCard Elevation="1" Class="rounded-lg border border-slate-200">
    <MudTable ServerData="LoadServerData" @ref="_table" Dense="true" Hover="true" Striped="true" Loading="@_loading">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Style="font-weight: 600;">Daftar Pelanggan</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchTerm" Placeholder="Cari kode, nama, NPWP..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="mt-0"
                          Clearable="true" Immediate="true" OnKeyUp="OnSearch" DebounceInterval="300" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Kode</MudTh>
            <MudTh>Nama Pelanggan</MudTh>
            <MudTh>Kontak (Email / Telp)</MudTh>
            <MudTh>Alamat Penagihan</MudTh>
            <MudTh Style="text-align: right;">Limit Kredit</MudTh>
            <MudTh Style="text-align: center;">Termin (Hari)</MudTh>
            <MudTh Style="text-align: center;">Status</MudTh>
            <MudTh Style="text-align: right;">Aksi</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Kode">
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                    @context.Code
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Nama">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Name</MudText>
                @if (!string.IsNullOrEmpty(context.TaxNumber))
                {
                    <MudText Typo="Typo.caption" Style="color: #64748B;">NPWP: @context.TaxNumber</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Kontak">
                <MudText Typo="Typo.caption" Style="display: block;">@context.Phone</MudText>
                <MudText Typo="Typo.caption" Style="color: #64748B;">@context.Email</MudText>
            </MudTd>
            <MudTd DataLabel="Alamat">
                <MudText Typo="Typo.body2" Style="font-size: 0.8rem; color: #475569; max-width: 250px;">
                    @context.BillingAddress
                </MudText>
            </MudTd>
            <MudTd DataLabel="Limit Kredit" Style="text-align: right; font-family: monospace; font-weight: 600;">
                Rp @context.CreditLimit.ToString("N0")
            </MudTd>
            <MudTd DataLabel="Termin" Style="text-align: center;">
                <MudChip T="string" Size="Size.Small">@context.PaymentTermsDays Hari</MudChip>
            </MudTd>
            <MudTd DataLabel="Status" Style="text-align: center;">
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktif</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Non-aktif</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Aksi" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteCustomerAsync(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Default" Class="mb-2" />
                <MudText Typo="Typo.body1" Style="font-weight: 600;">Belum ada data pelanggan</MudText>
                <MudText Typo="Typo.body2" Style="color: #64748B;">Klik "Tambah Pelanggan" untuk membuat master pelanggan baru.</MudText>
            </div>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" InfoFormat="{first_item}-{last_item} dari {all_items}" />
        </PagerContent>
    </MudTable>
</MudCard>

<!-- Dialog Tambah / Edit Pelanggan -->
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700;">
            @(_isEditMode ? "Ubah Data Pelanggan" : "Tambah Pelanggan Baru")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @if (!_isEditMode)
            {
                <MudTextField @bind-Value="_model.Code" Label="Kode Pelanggan (Unik)" Required="true"
                              Placeholder="Misal: CUST-001" Variant="Variant.Outlined" Margin="Margin.Dense" />
            }
            <MudTextField @bind-Value="_model.Name" Label="Nama Pelanggan / Institusi" Required="true"
                          Placeholder="Misal: PT Mitra Perkasa Abadi" Variant="Variant.Outlined" Margin="Margin.Dense" />

            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_model.Email" Label="Email Kontak"
                              Placeholder="billing@customer.com" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1" />
                <MudTextField @bind-Value="_model.Phone" Label="Nomor Telepon"
                              Placeholder="+62 21..." Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1" />
            </div>

            <MudTextField @bind-Value="_model.BillingAddress" Label="Alamat Penagihan (Billing)" Required="true" Lines="2"
                          Placeholder="Alamat penagihan lengkap..." Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField @bind-Value="_model.ShippingAddress" Label="Alamat Pengiriman (Shipping)" Lines="2"
                          Placeholder="Alamat gudang penerimaan barang..." Variant="Variant.Outlined" Margin="Margin.Dense" />

            <div class="d-flex gap-2">
                <MudTextField @bind-Value="_model.TaxNumber" Label="NPWP Perusahaan"
                              Placeholder="01.xxx.xxx.x-xxx.xxx" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1" />
                <MudNumericField @bind-Value="_model.CreditLimit" Label="Limit Kredit (Rp)" Format="N0" Min="0m"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1" />
                <MudNumericField @bind-Value="_model.PaymentTermsDays" Label="Termin Bayar (Hari)" Min="0"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1" />
            </div>

            <MudCheckBox @bind-Value="_model.IsActive" Label="Status Pelanggan Aktif" Color="Color.Primary" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false">Batal</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCustomerAsync" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Menyimpan...</span>
            }
            else
            {
                <span>Simpan</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<CustomerDto>? _table;
    private string? _searchTerm;
    private bool _loading;
    private bool _saving;
    private bool _dialogVisible;
    private bool _isEditMode;
    private CustomerFormModel _model = new();

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private async Task<TableData<CustomerDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            var query = new GetCustomersQuery(
                SearchTerm: _searchTerm,
                PageNumber: state.Page + 1,
                PageSize: state.PageSize);

            var result = await Sender.Send(query, cancellationToken);
            if (result.IsSuccess)
            {
                return new TableData<CustomerDto>
                {
                    TotalItems = result.Value.TotalCount,
                    Items = result.Value.Items
                };
            }

            Snackbar.Add(result.Error.Description, Severity.Error);
            return new TableData<CustomerDto> { TotalItems = 0, Items = [] };
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnSearch() => _table?.ReloadServerData();

    private void OpenCreateDialog()
    {
        _isEditMode = false;
        _model = new CustomerFormModel
        {
            CreditLimit = 50000000m,
            PaymentTermsDays = 30,
            IsActive = true
        };
        _dialogVisible = true;
    }

    private void OpenEditDialog(CustomerDto dto)
    {
        _isEditMode = true;
        _model = new CustomerFormModel
        {
            Id = dto.Id,
            CompanyId = dto.CompanyId,
            Code = dto.Code,
            Name = dto.Name,
            Email = dto.Email,
            Phone = dto.Phone,
            BillingAddress = dto.BillingAddress,
            ShippingAddress = dto.ShippingAddress,
            TaxNumber = dto.TaxNumber,
            CreditLimit = dto.CreditLimit,
            PaymentTermsDays = dto.PaymentTermsDays,
            IsActive = dto.IsActive
        };
        _dialogVisible = true;
    }

    private async Task SaveCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name) || string.IsNullOrWhiteSpace(_model.BillingAddress))
        {
            Snackbar.Add("Nama dan alamat penagihan pelanggan wajib diisi.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (_isEditMode)
            {
                var command = new UpdateCustomerCommand(
                    Id: _model.Id!.Value,
                    Name: _model.Name,
                    Email: _model.Email,
                    Phone: _model.Phone,
                    BillingAddress: _model.BillingAddress,
                    ShippingAddress: _model.ShippingAddress,
                    TaxNumber: _model.TaxNumber,
                    CreditLimit: _model.CreditLimit,
                    PaymentTermsDays: _model.PaymentTermsDays,
                    IsActive: _model.IsActive);

                var result = await Sender.Send(command);
                if (result.IsSuccess)
                {
                    Snackbar.Add("Data pelanggan berhasil diperbarui.", Severity.Success);
                    _dialogVisible = false;
                    _table?.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(result.Error.Description, Severity.Error);
                }
            }
            else
            {
                var companyId = (await DbContext.Companies.IgnoreQueryFilters().FirstAsync()).Id;

                var command = new CreateCustomerCommand(
                    CompanyId: companyId,
                    Code: _model.Code,
                    Name: _model.Name,
                    Email: _model.Email,
                    Phone: _model.Phone,
                    BillingAddress: _model.BillingAddress,
                    ShippingAddress: _model.ShippingAddress,
                    TaxNumber: _model.TaxNumber,
                    CreditLimit: _model.CreditLimit,
                    PaymentTermsDays: _model.PaymentTermsDays);

                var result = await Sender.Send(command);
                if (result.IsSuccess)
                {
                    Snackbar.Add("Pelanggan baru berhasil didaftarkan.", Severity.Success);
                    _dialogVisible = false;
                    _table?.ReloadServerData();
                }
                else
                {
                    Snackbar.Add(result.Error.Description, Severity.Error);
                }
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteCustomerAsync(CustomerDto dto)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Konfirmasi Hapus",
            $"Apakah Anda yakin ingin menghapus pelanggan '{dto.Name}' ({dto.Code})?",
            yesText: "Hapus", cancelText: "Batal");

        if (confirmed == true)
        {
            var result = await Sender.Send(new DeleteCustomerCommand(dto.Id));
            if (result.IsSuccess)
            {
                Snackbar.Add("Pelanggan berhasil dihapus.", Severity.Success);
                _table?.ReloadServerData();
            }
            else
            {
                Snackbar.Add(result.Error.Description, Severity.Error);
            }
        }
    }

    private class CustomerFormModel
    {
        public Guid? Id { get; set; }
        public Guid CompanyId { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string BillingAddress { get; set; } = string.Empty;
        public string? ShippingAddress { get; set; }
        public string? TaxNumber { get; set; }
        public decimal CreditLimit { get; set; }
        public int PaymentTermsDays { get; set; } = 30;
        public bool IsActive { get; set; } = true;
    }
}

