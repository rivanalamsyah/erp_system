@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ICurrentUserService CurrentUserService
@inject IApplicationDbContext DbContext
@inject ISnackbar Snackbar
@using ERP.Domain.Entities.Master
@using Microsoft.EntityFrameworkCore

<MudThemeProvider Theme="@ErpTheme.EnterpriseTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Top Application Bar -->
    <MudAppBar Elevation="1" Dense="true" Fixed="true" Style="background-color: #0F172A; border-bottom: 1px solid rgba(255,255,255,0.08);">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />

        <div class="d-none d-md-flex align-center ml-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1 text-slate-400" />
            <MudText Typo="Typo.subtitle2" Style="color: #F8FAFC; font-weight: 600;">
                PT Enterprise Sinergi Nusantara
            </MudText>
        </div>

        <MudSpacer />

        <!-- Dynamic Branch Switcher Menu -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <div class="d-flex align-center mr-4 px-3 py-1 cursor-pointer" style="background: rgba(255,255,255,0.07); border-radius: 6px; border: 1px solid rgba(255,255,255,0.12);">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" Class="mr-1" />
                    <div>
                        <MudText Typo="Typo.caption" Style="color: #94A3B8; font-size: 0.68rem; display: block; line-height: 1;">
                            CABANG AKTIF
                        </MudText>
                        <MudText Typo="Typo.body2" Style="color: #FFFFFF; font-weight: 600; font-size: 0.8rem; line-height: 1.2;">
                            @_activeBranchName
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="color: #94A3B8;" Class="ml-1" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <div class="px-3 py-2" style="background-color: #F1F5F9;">
                    <MudText Typo="Typo.caption" Style="font-weight: 700; color: #475569;">PILIH KANTOR CABANG</MudText>
                </div>
                <MudDivider />
                @foreach (var b in _availableBranches)
                {
                    <MudMenuItem OnClick="@(() => SwitchBranch(b))" Icon="@(b.IsHeadOffice ? Icons.Material.Filled.Star : Icons.Material.Filled.Store)">
                        <div class="d-flex justify-space-between align-center" style="min-width: 200px;">
                            <span style="font-weight: @(b.Id == _activeBranchId ? "700" : "400");">@b.Code &bull; @b.Name</span>
                            @if (b.Id == _activeBranchId)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" Class="ml-2" />
                            }
                        </div>
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>

        <!-- Quick Notifications Menu -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudBadge Content="@_unreadNotifications.Count" Color="Color.Warning" Overlap="true" Class="mr-3 cursor-pointer">
                    <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" Size="Size.Small" />
                </MudBadge>
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 py-2 d-flex justify-space-between align-center" style="background-color: #F8FAFC; min-width: 280px;">
                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Pemberitahuan Sistem</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary" Class="cursor-pointer">Tandai Dibaca</MudText>
                </div>
                <MudDivider />
                @foreach (var n in _unreadNotifications)
                {
                    <MudMenuItem Href="@n.Link" Icon="@n.Icon" IconColor="@n.Color">
                        <div>
                            <MudText Typo="Typo.body2" Style="font-weight: 600; font-size: 0.8rem;">@n.Title</MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748B;">@n.Message</MudText>
                        </div>
                    </MudMenuItem>
                }
            </ChildContent>
        </MudMenu>

        <!-- Dynamic User Profile Dropdown -->
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <div class="d-flex align-center cursor-pointer px-2 py-1" style="background: rgba(255,255,255,0.05); border-radius: 20px;">
                    <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-2">
                        @(_userInitials)
                    </MudAvatar>
                    <div class="d-none d-sm-block text-left mr-1">
                        <MudText Typo="Typo.body2" Style="color: #FFFFFF; font-weight: 600; font-size: 0.8rem; line-height: 1.1;">
                            @(_displayUserName)
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color: #38BDF8; font-size: 0.7rem; font-weight: 500;">
                            @(_displayRole)
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Style="color: #94A3B8;" />
                </div>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Outlined.Person" Href="/security/profile">
                    Profil Saya
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.LockReset" Href="/security/change-password">
                    Ganti Password
                </MudMenuItem>
                <MudDivider />
                <form action="/api/auth/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" style="background: none; border: none; width: 100%; text-align: left; padding: 0;">
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error">
                            Keluar (Logout)
                        </MudMenuItem>
                    </button>
                </form>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <!-- Sidebar Drawer -->
    <MudDrawer @bind-Open="@_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="DrawerVariant.Responsive" Width="260px" Style="background-color: #0B1120;">
        <NavMenu />
    </MudDrawer>

    <!-- Main Workspace Content Protected by ErrorBoundary -->
    <MudMainContent Class="pa-4 pa-md-6" Style="background-color: #F8FAFC; min-height: 100vh;">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <MudCard Elevation="2" Class="pa-6 my-6 border border-red-200 rounded-lg" Style="max-width: 680px; margin: 0 auto;">
                    <div class="d-flex align-center mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Color="Color.Error" Size="Size.Large" Class="mr-3" />
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700; color: #991B1B;">
                                Terjadi Kendala Pemrosesan Komponen
                            </MudText>
                            <MudText Typo="Typo.caption" Style="color: #64748B;">
                                Sesi sirkuit Anda tetap aman. Silakan muat ulang tampilan komponen di bawah ini.
                            </MudText>
                        </div>
                    </div>
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                        @ex.Message
                    </MudAlert>
                    <div class="d-flex gap-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecoverErrorBoundary">
                            Pulihkan Tampilan
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Href="/">
                            Kembali ke Dashboard
                        </MudButton>
                    </div>
                </MudCard>
            </ErrorContent>
        </ErrorBoundary>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    private string _activeBranchName = "HO-JKT • Head Office Jakarta";
    private Guid _activeBranchId = Guid.Empty;
    private List<Branch> _availableBranches = [];

    private string _displayUserName = "admin@enterprise.erp";
    private string _displayRole = "SUPER ADMIN";
    private string _userInitials = "SA";

    private record NotificationItem(string Title, string Message, string Link, string Icon, Color Color);
    private List<NotificationItem> _unreadNotifications = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        CurrentUserService.SetCurrentUserContext(authState.User);
        CurrentUserService.OnContextChanged += HandleContextChanged;

        var allowedBranchIds = CurrentUserService.AllowedBranchIds;

        var branchQuery = DbContext.Branches
            .AsNoTracking()
            .Where(b => !b.IsDeleted);

        if (!CurrentUserService.IsHeadOffice && !CurrentUserService.IsSuperAdmin && allowedBranchIds.Count > 0)
        {
            branchQuery = branchQuery.Where(b => allowedBranchIds.Contains(b.Id));
        }

        _availableBranches = await branchQuery
            .OrderBy(b => b.Code)
            .ToListAsync();

        if (_availableBranches.Count > 0)
        {
            var currentBranchId = CurrentUserService.BranchId;
            var activeBranch = _availableBranches.FirstOrDefault(b => b.Id == currentBranchId)
                ?? _availableBranches.FirstOrDefault(b => b.IsHeadOffice)
                ?? _availableBranches[0];

            _activeBranchId = activeBranch.Id;
            _activeBranchName = $"{activeBranch.Code} • {activeBranch.Name}";
            CurrentUserService.SetActiveBranch(activeBranch.Id, activeBranch.CompanyId, activeBranch.IsHeadOffice);
        }

        if (CurrentUserService.IsAuthenticated)
        {
            _displayUserName = CurrentUserService.FullName ?? CurrentUserService.UserName ?? "admin@enterprise.erp";
            _displayRole = CurrentUserService.Roles.FirstOrDefault()
                ?? (CurrentUserService.HasPermission("security.users.manage") ? "SUPER ADMIN" : "STAFF");

            if (!string.IsNullOrWhiteSpace(_displayUserName))
            {
                var parts = _displayUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                _userInitials = parts.Length > 1 
                    ? $"{parts[0][0]}{parts[1][0]}".ToUpper() 
                    : _displayUserName.Substring(0, Math.Min(2, _displayUserName.Length)).ToUpper();
            }
        }

        _unreadNotifications =
        [
            new("Purchase Request Baru", "PR/202611/0001 membutuhkan persetujuan manajer", "/procurement/requests", Icons.Material.Filled.Assignment, Color.Info),
            new("Sales Order Menunggu Rilis", "SO/202611/0001 telah diverifikasi limit kredit", "/sales/orders", Icons.Material.Filled.ShoppingCartCheckout, Color.Success),
            new("Pemberitahuan Pajak", "Tarif PPN Standar aktif 11% (UU HPP)", "/settings", Icons.Material.Filled.Receipt, Color.Warning)
        ];
    }

    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void RecoverErrorBoundary()
    {
        _errorBoundary?.Recover();
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void SwitchBranch(Branch branch)
    {
        try
        {
            CurrentUserService.SetActiveBranch(branch.Id, branch.CompanyId, branch.IsHeadOffice);
            _activeBranchId = branch.Id;
            _activeBranchName = $"{branch.Code} • {branch.Name}";
            Snackbar.Add($"Cabang operasional aktif beralih ke: {branch.Code} • {branch.Name}", Severity.Info);
            StateHasChanged();
        }
        catch (UnauthorizedAccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void HandleContextChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CurrentUserService.OnContextChanged -= HandleContextChanged;
    }
}
