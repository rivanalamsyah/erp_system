# Enterprise ERP System - Environment Configuration Template
# Copy this file to .env and configure secret keys before running docker compose

# Application Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
APP_PORT=5000

# PostgreSQL Database Settings
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_erp
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=P@ssw0rdEnterprise2026!

# Connection String for EF Core (constructed from database settings)
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=enterprise_erp;Username=erp_admin;Password=P@ssw0rdEnterprise2026!;Maximum Pool Size=100;

# Super Admin Initial Credentials (Seeded on first migration)
SUPERADMIN_EMAIL=superadmin@erp.local
SUPERADMIN_PASSWORD=SuperAdmin@ERP2026!

